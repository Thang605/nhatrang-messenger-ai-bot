# Cổng chạy server
PORT=3000

# Chuỗi xác thực Webhook tự đặt (Nhập chuỗi này vào ô Verify Token trên trang Meta for Developers)
FB_VERIFY_TOKEN=nhatrang_xe_tour_verify_2026

# Page Access Token lấy từ trang Meta for Developers (Messenger -> Settings -> Access Tokens)
FB_PAGE_ACCESS_TOKEN=EAAG...

# (Tùy chọn) Khóa DeepSeek API (ưu tiên số 1) hoặc Gemini API để AI trả lời tự nhiên mọi câu hỏi mở của khách
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_MODEL=deepseek-chat
GEMINI_API_KEY=AIzaSy...

# (Tùy chọn) Nhận thông báo tức thì qua Telegram mỗi khi khách để lại SĐT đặt xe/vé
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
